# ===================================================================
# MOONKY ENVIRONMENT CONFIGURATION
# Omnichannel Customer Service SaaS (WhatsApp + Instagram + AI)
# ===================================================================

# APP CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# SUPABASE (DATABASE & AUTHENTICATION)
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# WAME API INTEGRATION (WHATSAPP & INSTAGRAM DIRECT)
# Base URL defaults to production server https://server.wame.api.br
WAME_API_BASE_URL="https://server.wame.api.br"
# Instance key obtained in WAME Dashboard (https://wame.api.br)
WAME_DEFAULT_INSTANCE_KEY=""
# Optional secret token to verify incoming webhook payloads
WAME_WEBHOOK_SECRET="moonky_whsec_random_token"

# AI ENGINE CONFIGURATION (SERVER-SIDE)
# Providers supported: "gemini" | "openai" | "anthropic" | "demo"
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-pro"
AI_API_KEY=""

# AI GUARDRAIL SETTINGS
AI_CONFIDENCE_THRESHOLD="0.85"
AI_AUTO_HANDOFF_KEYWORDS="human,agent,atendente,humano,gerente,cancelar,especialista"
